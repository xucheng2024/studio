{
  "version": 1,
  "flows": [
    {
      "id": "apt04-appointments-local",
      "paths": [
        "src/app/[studioSlug]/appointments/**",
        "src/app/(app)/me/appointments/**",
        "src/lib/salon-appointments.ts",
        "src/lib/salon-appointments-self.ts",
        "scripts/run-local-uat.mjs",
        "scripts/lib/local-supabase-uat.mjs",
        "scripts/tests/local-supabase-uat.test.mjs",
        "scripts/verify-apt04-uat-local.mjs"
      ],
      "command": [
        "npm",
        "run",
        "test:local-uat"
      ],
      "target": {
        "policy": "command_local"
      },
      "data_access": {
        "policy": "local_only"
      }
    },
    {
      "id": "com01-commission-local",
      "paths": [
        "scripts/verify-com01-uat-browser-local.mjs",
        "scripts/sql/com01_uat_local_execute.sql",
        "scripts/run-com01-uat-local.mjs",
        "scripts/fixtures/com01-local-identities.mjs",
        "scripts/lib/com01-local-auth.mjs",
        "scripts/lib/local-supabase-uat.mjs",
        "scripts/tests/com01-local-auth-fixture.test.mjs",
        "scripts/tests/local-supabase-uat.test.mjs",
        "scripts/collect-com01-uat-evidence.sh",
        "supabase/migrations/20260814100000_com01_commission_foundation.sql",
        "supabase/migrations/20260814110000_com01_fixes_p1_p2.sql"
      ],
      "command": [
        "npm",
        "run",
        "test:com01-uat-local"
      ],
      "target": {
        "policy": "command_local"
      },
      "data_access": {
        "policy": "local_only"
      }
    },
    {
      "id": "crm02-clients-local",
      "paths": [
        "src/app/(app)/dashboard/clients/**",
        "scripts/verify-crm02-browser-local.mjs",
        "scripts/run-crm02-uat-local.mjs",
        "scripts/sql/crm02_uat_local_execute.sql",
        "scripts/fixtures/crm02-local-identities.mjs",
        "scripts/lib/local-fixture-auth.mjs",
        "scripts/lib/local-uat-safety.mjs",
        "scripts/lib/local-supabase-uat.mjs",
        "scripts/tests/local-uat-safety.test.mjs"
      ],
      "command": [
        "npm",
        "run",
        "test:crm02-uat-local"
      ],
      "target": {
        "policy": "command_local"
      },
      "data_access": {
        "policy": "local_only"
      }
    },
    {
      "id": "pos-packages-local",
      "paths": [
        "src/app/(app)/dashboard/pos/**",
        "src/app/(app)/dashboard/packages/**",
        "src/app/api/dashboard/pos/**",
        "src/app/api/dashboard/packages/**",
        "src/lib/pos-sales.ts",
        "src/lib/pos-sales-read.ts",
        "scripts/verify-pos-pkg-browser-local.mjs",
        "scripts/run-pos-pkg-uat-local.mjs",
        "scripts/sql/pos_uat_local_execute.sql",
        "scripts/fixtures/pos-local-identities.mjs",
        "scripts/lib/local-fixture-auth.mjs",
        "scripts/lib/local-uat-safety.mjs",
        "scripts/lib/local-supabase-uat.mjs",
        "scripts/tests/local-uat-safety.test.mjs"
      ],
      "command": [
        "npm",
        "run",
        "test:pos-pkg-uat-local"
      ],
      "target": {
        "policy": "command_local"
      },
      "data_access": {
        "policy": "local_only"
      },
      "requirements": {
        "commands": ["node", "npm", "npx", "psql"],
        "services": ["docker"]
      },
      "evidence": {
        "run_id_env": "UAT_FLOW_RUN_ID",
        "directories": ["tmp/pos-pkg-uat"],
        "index": "tmp/pos-pkg-uat/{run_id}/index.json",
        "index_schema": "uat-evidence-v1"
      },
      "concurrency": {
        "participants": 2,
        "isolation_keys": ["identity", "fixture_ids"],
        "barrier": "script_managed"
      }
    },
    {
      "id": "collect-com01-uat-evidence",
      "paths": [
        "scripts/collect-com01-uat-evidence.sh"
      ],
      "command": [
        "npm",
        "run",
        "collect:com01-uat-evidence"
      ],
      "target": {
        "policy": "none"
      },
      "data_access": {
        "policy": "remote_readonly"
      }
    },
    {
      "id": "test-pos01-e2e",
      "paths": [
        "scripts/verify-pos01-e2e.sh"
      ],
      "command": [
        "npm",
        "run",
        "test:pos01-e2e"
      ],
      "target": {
        "policy": "none"
      },
      "data_access": {
        "policy": "local_only"
      }
    }
  ]
}
