# Supabase — from Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Use either the anon (JWT) public key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Or the publishable key (newer projects):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the browser; required for API routes / RPCs
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Supabase Transaction pooler URI (recommended on Vercel serverless).
# Use Supabase Dashboard → Database → Connection string → Transaction mode.
# Point server-only clients at pooler; keep direct DB URL for migrations only.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# CRM-02 browser fixture account recovery only. Existing fixture accounts use magic links and do not need this.
# CRM02_TEST_PASSWORD=
# CRM02_BASE_URL=http://localhost:3000

# Vercel Cron — random secret; Vercel sends Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=
# Optional: PKG-02 ops checks scope (if empty, scan all studios)
# PKG02_OPS_STUDIO_ID=
# Optional: restrict PKG-02 ops checks to one location (requires PKG02_OPS_STUDIO_ID)
# PKG02_OPS_LOCATION_ID=
# Optional: backlog alert threshold for approved-not-applied count (default 20)
# PKG02_APPROVED_BACKLOG_ALERT_THRESHOLD=20
# Optional: Slack incoming webhook for ops alerts
# OPS_ALERT_SLACK_WEBHOOK_URL=

# Optional: Resend for emails
# RESEND_API_KEY=
# Optional: comma-separated platform super admin emails
# SUPER_ADMIN_EMAILS=admin@sgmystudio.com

# HitPay merchant-mode checkout integration
# Studio merchant credentials are set per studio in dashboard settings
# Optional API endpoint override (defaults to https://api.hit-pay.com)
# HITPAY_API_BASE_URL=
# Recurring billing (memberships): comma-separated HitPay methods (card, giro, shopee_recurring).
# If unset, SGD subscriptions default to giro; other currencies default to card.
# HITPAY_RECURRING_PAYMENT_METHODS=giro

# Optional: Web Push notifications for installed PWA (VAPID)
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:support@yourdomain.com
