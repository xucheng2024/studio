# Supabase — from Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Use either the anon (JWT) public key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Or the publishable key (newer projects):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the browser; required for API routes / RPCs
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Resend for emails
# RESEND_API_KEY=
# Optional: comma-separated platform super admin emails
# SUPER_ADMIN_EMAILS=admin@sgmystudio.com

# HitPay platform-mode checkout integration
# Shared SaaS platform key (set once on the server / hosting environment)
# HITPAY_PLATFORM_API_KEY=
# Studio sub-merchant credentials are set per studio in dashboard settings
# Optional API endpoint override (defaults to https://api.hit-pay.com)
# HITPAY_API_BASE_URL=
